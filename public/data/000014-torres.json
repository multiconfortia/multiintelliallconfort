  "preguntas_frecuentes": [

    {
      "pregunta": "¿Cada cuánto requiere mantenimiento una torre de enfriamiento?",
      "respuesta": "Depende de la calidad del agua y condiciones de operación. Se recomienda inspección periódica, limpieza, revisión mecánica y control químico."
    },

    {
      "pregunta": "¿Qué función tiene el relleno evaporativo?",
      "respuesta": "Incrementa el área de contacto entre aire y agua permitiendo una mayor transferencia térmica por evaporación."
    },

    {
      "pregunta": "¿Qué problemas provoca una torre sucia?",
      "respuesta": "Reduce la capacidad de rechazo de calor, aumenta consumo energético y puede provocar fallas en chillers o compresores."
    },

    {
      "pregunta": "¿Se puede automatizar una torre de enfriamiento?",
      "respuesta": "Sí. Puede integrarse control de ventiladores, bombas, temperatura, conductividad, nivel de agua y alarmas mediante PLC o BMS."
    }


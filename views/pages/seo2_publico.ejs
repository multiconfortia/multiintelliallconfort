<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <title><%= solucion.titulo %> | MULTICONFORT</title>

  <meta
    name="description"
    content="<%= solucion.descripcion %>">

  <meta
    name="robots"
    content="<%= indexable ? 'index,follow' : 'noindex,follow' %>">

  <link rel="canonical" href="<%= canonical %>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MULTICONFORT">
  <meta property="og:title" content="<%= solucion.titulo %> | MULTICONFORT">
  <meta property="og:description" content="<%= solucion.descripcion %>">
  <meta property="og:url" content="<%= canonical %>">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <style>
    body {
      background: #f8f9fa;
      color: #212529;
    }

    .seo2-hero {
      background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
      border-bottom: 1px solid #dee2e6;
      padding: 48px 0 42px;
    }

    .seo2-breadcrumb {
      font-size: 0.9rem;
      color: #6c757d;
      margin-bottom: 22px;
    }

    .seo2-breadcrumb a {
      text-decoration: none;
    }

    .seo2-card {
      background: #ffffff;
      border: 1px solid #dee2e6;
      border-radius: 12px;
      box-shadow: 0 .25rem .75rem rgba(0,0,0,.05);
    }

    .seo2-identity {
      border-left: 4px solid #0dcaf0;
      background: #f8f9fa;
      border-radius: 8px;
      padding: 18px 20px;
    }

    .seo2-label {
      font-size: .78rem;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #6c757d;
      font-weight: 700;
    }

    .seo2-code {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: .08em;
    }

    .seo2-content {
      padding: 32px;
    }

    .seo2-cta {
      margin-top: 28px;
    }
  </style>

  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": solucion.titulo + " | MULTICONFORT",
    "description": solucion.descripcion,
    "url": canonical,
    "isPartOf": {
      "@type": "WebSite",
      "name": "MULTICONFORT",
      "url": "https://www.multiconfort.com.mx/"
    }
  }) %>
  </script>
</head>

<body>

  <%- include("../partials/navbar_seo2") %>

  <section class="seo2-hero">
    <div class="container">

      <div class="seo2-breadcrumb">
        <a href="/">MULTICONFORT</a>
        <span class="mx-2">&rsaquo;</span>
        <a href="/soluciones">Soluciones</a>
        <span class="mx-2">&rsaquo;</span>
        <span><%= solucion.titulo %></span>
      </div>

      <div class="row">
        <div class="col-lg-9">

          <div class="seo2-label mb-2">
            SOLUCIÓN MULTICONFORT
          </div>

          <h1 class="display-5 fw-bold mb-3">
            <%= solucion.titulo %>
          </h1>

          <p class="lead mb-0">
            <%= solucion.descripcion %>
          </p>

        </div>
      </div>

    </div>
  </section>

  <main class="container py-5">

    <div class="seo2-card">

      <div class="seo2-content">

        <h2 class="h3 mb-3">
          Solución MULTICONFORT
        </h2>

        <p>
          MULTICONFORT identifica necesidades técnicas y las relaciona
          con soluciones orientadas a aplicaciones de climatización,
          refrigeración y automatización.
        </p>

        <section class="mt-4">
          <h2 class="h4">
            Aplicación
          </h2>

          <p>
            Esta página presenta una solución MULTICONFORT
            asociada a la consulta técnica identificada.
          </p>
        </section>

        <section class="mt-4">
          <h2 class="h4">
            Identidad MULTICONFORT
          </h2>

          <div class="seo2-identity mt-3">

            <div class="seo2-label">
              Código de solución MULTICONFORT
            </div>

            <div class="seo2-code mt-1">
              <%= solucion.codigo_solucion_multiconfort_base20 %>
            </div>

          </div>
        </section>

        <section class="seo2-cta">

          <a
            href="/soluciones"
            class="btn btn-outline-dark me-2">
            Explorar soluciones
          </a>

          <a
            href="/cotizacion"
            class="btn btn-info fw-semibold">
            Solicitar ingeniería
          </a>

        </section>

      </div>
    </div>

  </main>

  <%- include("../partials/footer_seo2") %>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
  </script>

</body>
</html>
